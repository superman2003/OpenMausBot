+fn chrome_command(executable: &std::ffi::OsStr) -> Command {
+    let mut command = Command::new(executable);
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        // Chrome Headless Shell is a console executable; flags on the daemon do not propagate.
+        command.creation_flags(0x08000000); // CREATE_NO_WINDOW
+    }
+    command
+}
+
+#[cfg(windows)]
+#[derive(serde::Deserialize)]
+struct WindowsChromeLauncher {
+    chrome: PathBuf,
+    args: Vec<String>,
+}
+
+#[cfg(windows)]
+fn windows_chrome_command(path: &Path, args: Vec<String>) -> Result<Command, String> {
+    if path.file_name() != Some(std::ffi::OsStr::new("chrome-launcher.json")) {
+        let mut command = chrome_command(path.as_os_str());
+        command.args(args);
+        return Ok(command);
+    }
+    let bytes = std::fs::read(path).map_err(|error| format!("Cannot read Chrome launcher: {error}"))?;
+    let launcher: WindowsChromeLauncher =
+        serde_json::from_slice(&bytes).map_err(|error| format!("Invalid Chrome launcher: {error}"))?;
+    if !launcher.chrome.is_absolute()
+        || !launcher.chrome.extension().and_then(|ext| ext.to_str()).is_some_and(|ext| ext.eq_ignore_ascii_case("exe"))
+    {
+        return Err("The Windows Chrome launcher requires an absolute executable path".into());
+    }
+    let mut command = chrome_command(launcher.chrome.as_os_str());
+    command.args(args).args(launcher.args);
+    Ok(command)
+}
